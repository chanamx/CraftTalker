{
  "name": "luker-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "verify:release": "node scripts/verify-release.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:provider": "vitest run src/__tests__/provider-runtime.smoke.test.ts",
    "runs:acknowledge-invalid-legacy": "tsx src/maintenance/acknowledge-invalid-legacy-run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "hono": "^4.6.0",
    "tiktoken": "^1.0.22",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vitest": "^4.1.5"
  }
}
